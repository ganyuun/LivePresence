{
    "name": "LivePresence",
    "description": "Discord RPC",
    "version": "0.1",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "manifest_version": 3,
    "action": {"default_popup": "home.html"},
    "background": {"service_worker": "service-worker.js", "type": "module"},
    "permissions": ["tabs", "scripting"],
    "host_permissions": ["http://*/*", "https://*/*"]
}